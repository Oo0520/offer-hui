# ===== 数据管道配置 =====
# 存储：sqlite（本地） | supabase（云）
STORAGE_BACKEND=sqlite
DB_PATH=./data/offer.db

# Supabase（拿到项目 URL + service_role key 后填写，STORAGE_BACKEND 切 supabase 即启用）
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 爬虫行为
USER_AGENT=OfferHubBot/1.0 (+contact@offerhub.local)
REQUEST_DELAY=1.2
MAX_ITEMS_PER_SOURCE=30
